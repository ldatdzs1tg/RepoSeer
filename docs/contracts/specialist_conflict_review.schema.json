{
  "$comment": "Generated by scripts/export_specialist_agents.py; contract=0.1.0; generator=1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural schema. Temporal, quote and cross-boundary checks require specialist_agents.py validators.",
  "properties": {
    "analysis_run_id": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "title": "Analysis Run Id",
      "type": "string"
    },
    "cluster_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Cluster Id",
      "type": "string"
    },
    "deterministic_recheck_passed": {
      "title": "Deterministic Recheck Passed",
      "type": "boolean"
    },
    "final_use": {
      "enum": [
        "e2_feature",
        "event_candidate",
        "report_only",
        "rejected"
      ],
      "title": "Final Use",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    },
    "record_type": {
      "const": "conflict_review",
      "title": "Record Type",
      "type": "string"
    },
    "review_calls": {
      "enum": [
        0,
        1
      ],
      "title": "Review Calls",
      "type": "integer"
    },
    "reviewer_version": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewer Version"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signal_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 2,
      "title": "Signal Ids",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "no_conflict",
        "resolved",
        "unresolved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "analysis_run_id",
    "cluster_id",
    "subject_id",
    "signal_ids",
    "source_ids",
    "review_calls",
    "reviewer_version",
    "status",
    "deterministic_recheck_passed",
    "final_use",

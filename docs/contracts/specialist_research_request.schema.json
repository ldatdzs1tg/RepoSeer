{
  "$comment": "Generated by scripts/export_specialist_agents.py; contract=0.1.0; generator=1",
  "$defs": {
    "ResearchCandidate": {
      "additionalProperties": false,
      "description": "Unverified upstream reference for research, never a D06 receipt.",
      "properties": {
        "available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available At"
        },
        "candidate_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Id",
          "type": "string"
        },
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fetched At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "relevance_status": {
          "enum": [
            "relevant",
            "unresolved",
            "not_assessed"
          ],
          "title": "Relevance Status",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "official",
            "external",
            "unknown"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Ref",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "text_excerpt": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Excerpt"
        },
        "topic_hint": {
          "anyOf": [
            {
              "enum": [
                "maintenance",
                "functional",
                "alternatives"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Topic Hint"
        }
      },
      "required": [
        "candidate_id",
        "source_ref",
        "source_url",
        "source_kind",
        "relevance_status",
        "topic_hint",
        "text_excerpt",
        "published_at",
        "available_at",
        "fetched_at"
      ],
      "title": "ResearchCandidate",
      "type": "object"
    },
    "Specialist": {
      "enum": [
        "maintenance_lifecycle",
        "functional_trend_demand",
        "alternatives_migration"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural schema. Temporal, quote and cross-boundary checks require specialist_agents.py validators.",
  "properties": {
    "agent_kind": {
      "$ref": "#/$defs/Specialist"
    },
    "analysis_run_id": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "title": "Analysis Run Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ResearchCandidate"
      },
      "maxItems": 50,
      "title": "Candidates",
      "type": "array"
    },
    "cutoff_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Cutoff At",
      "type": "string"
    },
    "description_source_refs": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Description Source Refs",
      "type": "array"
    },
    "package_description": {
      "anyOf": [
        {
          "maxLength": 5000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Package Description"
    },
    "package_id": {
      "pattern": "^pypi:[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Package Id",
      "type": "string"
    },
    "record_type": {
      "const": "specialist_research_request",
      "title": "Record Type",
      "type": "string"
    },
    "repo_id": {
      "anyOf": [
        {
          "pattern": "^github:repository:[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Repo Id"
    },
    "request_id": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "research_questions": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Research Questions",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "analysis_run_id",
    "request_id",
    "agent_kind",
    "package_id",
    "repo_id",
    "cutoff_at",
    "package_description",
    "description_source_refs",
    "candidates",
    "research_questions"
  ],
  "title": "ResearchHandoffRequest",
  "type": "object"
}

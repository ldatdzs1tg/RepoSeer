# GitHub API
GITHUB_TOKEN=

# Application Configuration
REPOSEER_ENV=development
DATA_DIR=data
CONFIG_DIR=configs
LOG_LEVEL=INFO

# External discovery: local personal keys required by RepoSeer V2.
# DEV.to and Stack Exchange also have public endpoints.
# Hacker News needs no key. Never commit .env or upload it to Drive.
NEWS_API_KEY=
DEVTO_API_KEY=
STACKEXCHANGE_API_KEY=

# RSS has no API key; comma-separated public HTTPS RSS/Atom feed URLs.
REPOSEER_RSS_FEEDS=

# T-026 specialist LLMs: loaded from .env only for live runs.
# Process environment overrides .env; CLI --model overrides REPOSEER_AGENT_MODEL.
# Use openrouter (default), or openai for the direct OpenAI endpoint.
REPOSEER_AGENT_PROVIDER=openrouter
# Required: exact OpenRouter model ID (<provider>/<model>) supporting structured outputs.
# No model is selected automatically.
REPOSEER_AGENT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional application attribution; leave referer blank if unused.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=RepoSeer
# Valid ranges: timeout (0, 120] seconds; output tokens [256, 8000].
REPOSEER_AGENT_TIMEOUT_SECONDS=20
REPOSEER_AGENT_MAX_OUTPUT_TOKENS=3200
# Only required when REPOSEER_AGENT_PROVIDER=openai. SDK retries remain fixed at 0.
OPENAI_API_KEY=

# GitHub API
GITHUB_TOKEN=

# Application Configuration
REPOSEER_ENV=development
DATA_DIR=data
CONFIG_DIR=configs
LOG_LEVEL=INFO

# External discovery: local personal keys required by RepoSeer V2.
# DEV.to and Stack Exchange also have public endpoints.
# Hacker News needs no key. Never commit .env or upload it to Drive.
NEWS_API_KEY=
DEVTO_API_KEY=
STACKEXCHANGE_API_KEY=

# RSS has no API key; comma-separated public HTTPS RSS/Atom feed URLs.
REPOSEER_RSS_FEEDS=
